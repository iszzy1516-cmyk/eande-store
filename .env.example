DATABASE_URL="file:./dev.db"
SESSION_SECRET="replace-with-a-long-random-string"

# Public base URL of the deployed site (used for payment redirects). No trailing slash.
NEXT_PUBLIC_APP_URL=""

# Bachs payments
BACHS_SECRET_KEY=""
BACHS_WEBHOOK_SECRET=""

# Initial admin password for `npx prisma db seed` (min 8 chars; never committed)
ADMIN_INITIAL_PASSWORD=""

# Telegram ALERTS bot — sends paid-order alerts to the admin chat (from @BotFather)
TELEGRAM_ALERTS_BOT_TOKEN=""
# Telegram UPLOAD bot — conversational product uploads via npm run bot (from @BotFather)
TELEGRAM_UPLOAD_BOT_TOKEN=""
# Chat ID that receives order alerts and may upload products — message the bot /start to get yours
TELEGRAM_ADMIN_CHAT_ID=""
