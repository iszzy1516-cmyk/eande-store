DATABASE_URL="file:./dev.db"
SESSION_SECRET="replace-with-a-long-random-string"

# Public base URL of the deployed site (used for payment redirects). No trailing slash.
NEXT_PUBLIC_APP_URL=""

# Bachs payments
BACHS_SECRET_KEY=""
BACHS_WEBHOOK_SECRET=""

# Initial admin password for `npx prisma db seed` (min 8 chars; never committed)
ADMIN_INITIAL_PASSWORD=""

# Telegram ALERTS bot — sends paid-order alerts to the admin chat (from @BotFather)
TELEGRAM_ALERTS_BOT_TOKEN=""
# Telegram UPLOAD bot — conversational product uploads via npm run bot (from @BotFather)
TELEGRAM_UPLOAD_BOT_TOKEN=""
# Chat ID that receives order alerts and may upload products — message the bot /start to get yours
TELEGRAM_ADMIN_CHAT_ID=""

# --- Split hosting (Cloudflare Pages frontend + Railway API) ---
# Public URL of the API the browser should call (no trailing slash)
NEXT_PUBLIC_API_URL=""
# Origin of the Pages frontend, allowed to call the API with cookies
FRONTEND_ORIGIN=""

# Cloudflare R2 for bot-uploaded product photos (optional — local fallback)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
R2_PUBLIC_URL=""
